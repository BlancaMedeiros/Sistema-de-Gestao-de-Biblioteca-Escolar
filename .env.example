# Copie este arquivo para .env antes do primeiro `npm run dev`.
# Estes valores são exclusivos do ambiente local de desenvolvimento.
MYSQL_ROOT_PASSWORD=altere-esta-senha-local
MYSQL_DATABASE=biblioteca
MYSQL_USER=biblioteca_app
MYSQL_PASSWORD=altere-esta-senha-da-aplicacao

MYSQL_PORT=3306
BACKEND_PORT=3000
FRONTEND_PORT=4200

# Segredo usado para assinar o cookie de sessão (express-session). Gere um
# valor aleatório próprio, por exemplo com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=altere-este-segredo-de-sessao-local

# Produção (Cloud Run + MySQL no Aiven) não usa este arquivo: as variáveis
# ficam no serviço Cloud Run e os segredos (DB_PASSWORD, DB_SSL_CA,
# SESSION_SECRET) no Secret Manager. DB_SSL_CA (conteúdo do certificado CA) e
# DB_CONNECTION_LIMIT só são definidos lá — ver docs/deploy-firebase-cloud-run.md.
# Para aplicar migrations em produção a partir da sua máquina, use .env.aiven
# e aiven-ca.pem (ambos fora do Git) com `npm run prod:migrate`.
